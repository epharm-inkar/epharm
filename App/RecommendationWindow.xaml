<Window x:Class="CustomerDisplay.RecommendationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рекомендации Epharm"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        Width="500"
        MaxHeight="900"
        FontFamily="Segoe UI"
        Foreground="#1C1B19">

    <!-- 1.0.96: compact. Header, the asked product and each offer take about half the height of 1.0.91, so three
         replacements fit on a 768-pixel screen. Bonus first, as in the 1.0.91 design (INK-141). -->
    <Window.Resources>
        <SolidColorBrush x:Key="Header" Color="#073F46"/>
        <SolidColorBrush x:Key="HeaderMuted" Color="#B2CBCF"/>
        <SolidColorBrush x:Key="Accent" Color="#07877F"/>
        <SolidColorBrush x:Key="Bonus" Color="#0A7A3B"/>
        <SolidColorBrush x:Key="Muted" Color="#5E6B6D"/>
        <SolidColorBrush x:Key="Hairline" Color="#DCE8E8"/>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colour follows the bonus on this offer, never the rule or the other offers. -->
        <DataTemplate x:Key="OfferRowTemplate">
            <Border x:Name="OfferCard" BorderThickness="1" CornerRadius="9" Margin="0,0,0,6"
                    Background="White" BorderBrush="{StaticResource Hairline}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AccentStrip" CornerRadius="8,0,0,8" Background="Transparent"/>

                    <Grid Grid.Column="1" Margin="10,7,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="NameText" Text="{Binding Name, Mode=OneWay}" FontSize="16.5"
                                   FontWeight="Bold" TextWrapping="Wrap" LineHeight="20" Margin="0,1,8,0"/>
                        <Border x:Name="BonusChip" Grid.Column="1" CornerRadius="7" Padding="8,1,8,2"
                                VerticalAlignment="Top" HorizontalAlignment="Right" Background="Transparent">
                            <TextBlock x:Name="BonusText" Text="{Binding BonusBadge, Mode=OneWay}" TextWrapping="NoWrap"/>
                        </Border>

                        <TextBlock x:Name="MetaText" Grid.Row="1" Text="{Binding Meta, Mode=OneWay}" FontSize="13"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,1,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PriceText" Grid.Row="1" Grid.Column="1" Text="{Binding Price, Mode=OneWay}"
                                   FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,1,0,0"/>

                        <TextBlock x:Name="TriggerText" Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding TriggerContext, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                        <TextBlock x:Name="DetailText" Grid.Row="3" Grid.ColumnSpan="2" FontSize="14"
                                   TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0">
                            <Run x:Name="DetailPrefix" Text="{Binding DetailLabel, Mode=OneWay}" FontWeight="Bold"
                                 Foreground="{StaticResource Accent}"/><Run Text="{Binding Detail, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock x:Name="FootText" Grid.Row="4" Grid.ColumnSpan="2" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,3,0,0">
                            <Run Text="{Binding GoalLead, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Bonus}"/><Run Text="{Binding StockShown, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasBonus}" Value="False">
                    <Setter TargetName="BonusText" Property="FontSize" Value="12.5"/>
                    <Setter TargetName="BonusText" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="BonusText" Property="Foreground" Value="#5E6B6D"/>
                    <Setter TargetName="BonusChip" Property="Padding" Value="0,2,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasBonus}" Value="True">
                    <Setter TargetName="OfferCard" Property="Background" Value="#F3FBF6"/>
                    <Setter TargetName="OfferCard" Property="BorderBrush" Value="#A7D8B9"/>
                    <Setter TargetName="AccentStrip" Property="Background" Value="#0A7A3B"/>
                    <Setter TargetName="BonusChip" Property="Background" Value="#0A7A3B"/>
                    <Setter TargetName="BonusText" Property="FontSize" Value="17"/>
                    <Setter TargetName="BonusText" Property="FontWeight" Value="ExtraBold"/>
                    <Setter TargetName="BonusText" Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFoot}" Value="False">
                    <Setter TargetName="FootText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDetail}" Value="False">
                    <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Meta}" Value="">
                    <Setter TargetName="MetaText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TriggerContext}" Value="">
                    <Setter TargetName="TriggerText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" Background="White" Margin="12"
            BorderBrush="#C9D9DA" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#0B2A2E" Opacity="0.30" BlurRadius="30" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Header}" CornerRadius="15,15,0,0"
                    Padding="16,8,9,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TbHeadline" Text="Предложите покупателю" Foreground="White"
                                   FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                        <StackPanel x:Name="PharmacistGreeting" Orientation="Horizontal"
                                    Margin="0,1,0,0" Visibility="Collapsed">
                            <Ellipse Width="7" Height="7" Fill="#7FE0B5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbPharmacistName" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text=", бонус начислим вам" Foreground="{StaticResource HeaderMuted}"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top"
                            Style="{StaticResource CloseButton}" Click="OnCloseClick"
                            ToolTip="Закрыть подсказки">
                        <TextBlock Text="×" FontSize="22" Margin="0,-3,0,0" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1">
                <!-- One tab per basket product with offers; the last scanned product is open. -->
                <StackPanel x:Name="TriggerTabsPanel" Margin="12,8,12,0" Visibility="Collapsed">
                    <WrapPanel x:Name="TriggerTabs"/>
                </StackPanel>
                <Border x:Name="TopTriggerContext" Background="#EAF3F3"
                        CornerRadius="8" Margin="12,8,12,0" Padding="10,6,10,7">
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="18">
                        <Run x:Name="TbTopTriggerLabel" Text="Покупатель попросил" Foreground="#4F6B6E"
                             FontSize="12.5" FontWeight="SemiBold"/><Run Text=": " Foreground="#4F6B6E" FontSize="12.5"/><Run x:Name="TbTopTrigger" FontWeight="Bold" Foreground="#1C1B19"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="2" MaxHeight="700" MinHeight="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalFirst" CanContentScroll="True"
                          Padding="0,0,3,0">
                <StackPanel Margin="12,6,9,6">
                    <StackPanel x:Name="PanelSubstitutions" Margin="0,0,0,4">
                        <TextBlock x:Name="TbSubstitutionCount" Foreground="{StaticResource Accent}"
                                   FontSize="12.5" FontWeight="ExtraBold" Margin="2,0,0,4"/>
                        <ItemsControl x:Name="SubstitutionList"
                                      ItemTemplate="{StaticResource OfferRowTemplate}"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelCrossSells">
                        <TextBlock x:Name="TbCrossSellCount" Foreground="{StaticResource Accent}"
                                   FontSize="12.5" FontWeight="ExtraBold" Margin="2,0,0,4"/>
                        <Border x:Name="CrossSellTrigger" Background="#EAF3F3"
                                CornerRadius="8" Padding="10,5" Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" FontSize="13.5">
                                <Run Text="Уже в чеке: " Foreground="#4F6B6E" FontSize="12.5" FontWeight="SemiBold"/><Run x:Name="TbCrossSellTrigger" FontWeight="SemiBold" Foreground="#1C1B19"/>
                            </TextBlock>
                        </Border>
                        <ItemsControl x:Name="CrossSellList"
                                      ItemTemplate="{StaticResource OfferRowTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
